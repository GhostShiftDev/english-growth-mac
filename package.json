{
  "name": "english-growth",
  "productName": "English Growth",
  "version": "1.0.1",
  "description": "English learning app for teachers - groups, lessons, tests, progress, export & print",
  "main": "main.js",
  "author": "Axel Garnica Estrada",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -m --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.english.growth",
    "defaultArch": "x64",
    "mac": {
      "target": ["dmg"],
      "minimumSystemVersion": "10.13",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSPrintingUsageDescription": "English Growth needs printing to create worksheets and exams as PDF."
      }
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        { "x": 130, "y": 210, "type": "link", "path": "/Applications" },
        { "x": 410, "y": 210, "type": "file" }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "content.js",
      "style.css",
      "index.html",
      "node_modules/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^20.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "xlsx": "^0.18.5"
  }
}
